<?xml version="1.0" encoding="utf-8"?>
<!-- jarak antar baris diatur lewat padding, karena margin tidak berlaku di ListView -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="18dp"
    android:paddingVertical="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/slate"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- gambar gerakan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/charcoal"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgGerakan"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Gambar gerakan"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <!-- nama dan keterangan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNamaGerakan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Nama Gerakan"
                    android:textColor="@color/off_white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtKeterangan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Keterangan"
                    android:textColor="@color/muted_gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>